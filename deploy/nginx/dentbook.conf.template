# nginx перед API. Плейсхолдеры подставляет deploy/README.md (шаг «nginx и SSL»):
#   {{DOMAIN}}         — dentbook.example.com
#   {{LISTEN_IP}}      — IP в директивах listen; должен совпадать с listen остальных
#                        сайтов сервера, иначе nginx отдаст запрос их блоку server
#   {{API_HOST_PORT}}  — порт API на 127.0.0.1 (API_HOST_PORT из .env, по умолчанию 3100)

server {
    listen {{LISTEN_IP}}:80;
    server_name {{DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dentbook-acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{LISTEN_IP}}:443 ssl;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:{{API_HOST_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Сквозной request_id (CLAUDE.md §9): nginx и API пишут один идентификатор
        proxy_set_header X-Request-Id $request_id;
    }
}
