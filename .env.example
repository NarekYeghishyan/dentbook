# Скопировать в .env и заполнить. Пустые значения здесь — намеренно (CLAUDE.md §12).
# Разбор через zod при старте: отсутствие обязательной переменной = падение процесса.

# --- runtime ---
NODE_ENV=
LOG_LEVEL=

# --- api ---
API_HOST=
API_PORT=
# Адрес платформы снаружи, https://… — нужен боту Telegram (вебхук и Mini App)
PUBLIC_BASE_URL=
# Каталог собранной админки (apps/admin/dist); пусто — /admin не раздаётся,
# в разработке админка идёт через Vite (pnpm --filter @dentbook/admin dev)
ADMIN_DIST_DIR=

# --- postgres ---
# Порт на хосте для docker compose (пусто — 5432)
POSTGRES_PORT=
DATABASE_URL=

# --- сервер (deploy/docker-compose.yml) ---
# Пароль БД в серверном стеке; DATABASE_URL там собирается из него
POSTGRES_PASSWORD=
# Порт API на 127.0.0.1 сервера, на него проксирует nginx (пусто — 3100)
API_HOST_PORT=

# --- redis (кеш доступности + BullMQ) ---
# Порт на хосте для docker compose (пусто — 6379)
REDIS_PORT=
REDIS_URL=

# --- auth (сессии админки) ---
# Подпись сессий, не короче 32 символов: openssl rand -hex 32
JWT_SECRET=
# Время жизни сессии, секунды (пусто — 43200, 12 ч)
JWT_ACCESS_TTL=
# Попыток входа/регистрации в минуту с одного IP (пусто — 10)
AUTH_RATE_LIMIT=

# --- публичный API: холды и лимиты (Q4) ---
# Сколько секунд держится слот после POST /holds (пусто — 600)
HOLD_TTL_SEC=
# Запросов в минуту на ключ pk_ (пусто — 60)
PUBLIC_KEY_RATE_LIMIT=
# Холдов и SMS-кодов в минуту с одного IP (пусто — 10)
PUBLIC_IP_RATE_LIMIT=

# --- telegram (§8): бот врачей и Mini App; пусто — выключены ---
# Токен от @BotFather; нужен и API, и worker (отправка сообщений из очереди)
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылок привязки t.me/<bot>?start=<token>
TELEGRAM_BOT_USERNAME=
# Секрет заголовка вебхука: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Вебхук — PUBLIC_BASE_URL/telegram/webhook, Mini App — PUBLIC_BASE_URL/miniapp/.
# После смены токена или домена: node --import tsx apps/api/src/telegram-setup.ts
# Каталог собранного Mini App (apps/miniapp/dist); пусто — /miniapp не раздаётся
MINIAPP_DIST_DIR=

# --- SMS (Q5): коды подтверждения и уведомления ---
# twilio или пусто — без провайдера POST /v1/public/verifications отвечает 503, а
# напоминаний и SMS о подтверждении нет. Нужны и API (коды), и worker (уведомления)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Отправитель: номер в E.164 (+1…) или Messaging Service SID (MG…)
SMS_SENDER=

# --- капча в форме записи: Cloudflare Turnstile (Q5); пусто — выключена ---
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# --- статика: форма записи (apps/widget/dist); пусто — /widget не раздаётся ---
WIDGET_DIST_DIR=
