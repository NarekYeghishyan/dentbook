# Скопировать в .env и заполнить. Пустые значения здесь — намеренно (CLAUDE.md §12).
# Разбор через zod при старте: отсутствие обязательной переменной = падение процесса.

# --- runtime ---
NODE_ENV=
LOG_LEVEL=

# --- api ---
API_HOST=
API_PORT=
PUBLIC_BASE_URL=
ADMIN_ORIGIN=

# --- postgres ---
# Порт на хосте для docker compose (пусто — 5432)
POSTGRES_PORT=
DATABASE_URL=

# --- redis (кеш доступности + BullMQ) ---
# Порт на хосте для docker compose (пусто — 6379)
REDIS_PORT=
REDIS_URL=

# --- auth ---
JWT_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# --- холды слотов ---
HOLD_TTL_SEC=

# --- telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
MINIAPP_URL=

# --- sms-провайдер (верификация телефона + уведомления) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# --- капча в виджете ---
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
