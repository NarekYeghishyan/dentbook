{
  "name": "@dentbook/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "size": "node -e \"const z=require('node:zlib'),f=require('node:fs');const b=f.readFileSync('dist/dentbook-widget.js');console.log('gzip',(z.gzipSync(b).length/1024).toFixed(1),'KB / limit 50 KB')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dentbook/shared": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.1.9"
  }
}
